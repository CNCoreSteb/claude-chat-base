# 复制为 .env（或直接在 shell 里 export 这些变量），再运行 `uv run ccb`。
#
# CCB 专注于多 Claude Code 协作：各仓库的实例通过 MCP/Skill 接入共享主题群聊。

# GUI / API 服务的网络绑定。
CCB_HOST=127.0.0.1
CCB_PORT=8800

# 调试页端口（默认 0=关闭）。设为如 8801 即在 127.0.0.1 上开「完整状态追踪」调试页。
# CCB_DEBUG_PORT=8801

# SQLite 数据库 ccb.db（含全部配置与消息）的写入目录。
CCB_DATA_DIR=.ccb

# 启动时自动打开浏览器。
CCB_OPEN_BROWSER=true

# MCP / Skill 客户端连接 CCB 的地址（一般无需改；客户端读取此环境变量）。
# CCB_URL=http://127.0.0.1:8800
