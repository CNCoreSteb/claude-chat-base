# 复制为 .env（或直接在 shell 里 export 这些变量），再运行 `uv run ccb`。
#
# CCB 当前**专注于多 Claude Code 协作**；API 驱动的"AI 智能体自动对话"已停用（代码休眠保留）。
# 因此下面与 AI 相关的项（密钥/模型/节奏）当前**不生效**，可留空/忽略。

# GUI / API 服务的网络绑定。
CCB_HOST=127.0.0.1
CCB_PORT=8800

# SQLite 数据库 ccb.db（含全部配置与消息）的写入目录。
CCB_DATA_DIR=.ccb

# 启动时自动打开浏览器。
CCB_OPEN_BROWSER=true

# MCP / Skill 客户端连接 CCB 的地址（一般无需改；客户端读取此环境变量）。
# CCB_URL=http://127.0.0.1:8800

# —— 以下为 AI 智能体相关（当前停用，休眠保留，恢复 AI 编排后才有意义）——
# CCB_ANTHROPIC_API_KEY=
# CCB_PROVIDER=auto
# CCB_DEFAULT_MODEL=claude-sonnet-4-6
# CCB_DIRECTOR_MODEL=claude-haiku-4-5-20251001
# CCB_TURN_DELAY=1.2
# CCB_MAX_TURNS=24
