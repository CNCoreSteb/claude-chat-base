# 复制为 .env（或直接在 shell 里 export 这些变量），再运行 `uv run ccb`。
# 不设置密钥时，CCB 会使用内置的 "mock" 提供方，GUI 仍可正常工作。

# 你的 Anthropic API 密钥。设置后，智能体将由真实的 Claude 模型驱动。
CCB_ANTHROPIC_API_KEY=

# GUI / API 服务的网络绑定。
CCB_HOST=127.0.0.1
CCB_PORT=8800

# AI 智能体和主持人（导演）默认使用的模型。
CCB_DEFAULT_MODEL=claude-sonnet-4-6
CCB_DIRECTOR_MODEL=claude-haiku-4-5-20251001

# 不管是否检测到密钥，强制指定提供方："auto" | "anthropic" | "mock"。
CCB_PROVIDER=auto

# 对话节奏。
CCB_TURN_DELAY=1.2
CCB_MAX_TURNS=24

# 对话记录与房间状态的写入目录。
CCB_DATA_DIR=.ccb

# 启动时自动打开浏览器。
CCB_OPEN_BROWSER=true
