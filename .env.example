# Copy to .env (or just export these in your shell) before running `uv run agora`.
# Without a key, Agora runs the built-in "mock" provider so the GUI still works.

# Your Anthropic API key. When set, agents are powered by real Claude models.
AGORA_ANTHROPIC_API_KEY=

# Network binding for the GUI / API server.
AGORA_HOST=127.0.0.1
AGORA_PORT=8800

# Default model used by AI agents and the moderator/director.
AGORA_DEFAULT_MODEL=claude-sonnet-4-6
AGORA_DIRECTOR_MODEL=claude-haiku-4-5-20251001

# Force a provider regardless of key detection: "auto" | "anthropic" | "mock".
AGORA_PROVIDER=auto

# Conversation pacing.
AGORA_TURN_DELAY=1.2
AGORA_MAX_TURNS=24

# Where transcripts and room snapshots are written.
AGORA_DATA_DIR=.agora

# Open the browser automatically on start.
AGORA_OPEN_BROWSER=true
